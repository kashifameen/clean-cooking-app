{
  "name": "clean-cooking-app",
  "version": "1.1.2",
  "private": true,
  "description": "Clean Cooking halal high-protein cookbook for the web and Android.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./public/css/tailwind.css --minify",
    "android:sync": "cap sync android",
    "android:debug": "npm run build:css && cap sync android && cd android && chmod +x gradlew && ./gradlew assembleDebug",
    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:scale": "node tests/scale.test.mjs",
    "test:ui": "node tests/smoke-ui.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "puppeteer-core": "24.15.0",
    "tailwindcss": "3.4.17"
  }
}
